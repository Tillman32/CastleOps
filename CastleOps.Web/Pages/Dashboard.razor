@page "/"
@using System.Text.Json

<PageTitle>CastleOps - Dashboard</PageTitle>

<div class="container">
    <h1>Dashboard</h1>
</div>

<MudCard Width="150px" Class="ma-4">
    <MudCardContent Class="d-flex flex-column align-items-center">
        <MudText>Devices</MudText>
        <MudText Typo="Typo.h3">@TotalDevices</MudText>
    </MudCardContent>
</MudCard>

@code {
        public ICollection<DeviceDTO> Devices { get; set; } = new List<DeviceDTO>();

        // Statistics
        public int TotalDevices { get; set; }
        public int TotalPeons { get; set; }
        public int TotalPeonJobs { get; set; }

        protected override async Task OnInitializedAsync()
        {
            await LoadDevicesAsync();
            CalculateStatistics();
        }

        private async Task LoadDevicesAsync()
        {
            HttpClient client = new HttpClient();
            var response = await client.GetAsync("https://localhost:5001/api/devices");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                Console.WriteLine(json);
                Devices = JsonSerializer.Deserialize<List<DeviceDTO>>(json);
            }
            else
            {
                // Handle error response
            }
        }

        private void CalculateStatistics()
        {
            TotalDevices = Devices.Count();
            // TotalPeons and TotalPeonJobs calculation logic here
        }
}