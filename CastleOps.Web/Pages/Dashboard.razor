@page "/"
@inject CastleOpsClient Client

<PageTitle>CastleOps - Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudCard Class="ma-2">
                <MudCardContent Class="d-flex flex-column align-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.Devices" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h3">@TotalDevices</MudText>
                    <MudText Typo="Typo.subtitle1">Devices</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Class="ma-2">
                <MudCardContent Class="d-flex flex-column align-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.Work" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h3">@TotalPeons</MudText>
                    <MudText Typo="Typo.subtitle1">Peons</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Class="ma-2">
                <MudCardContent Class="d-flex flex-column align-center pa-6">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Tertiary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h3">@TotalPeonJobs</MudText>
                    <MudText Typo="Typo.subtitle1">Peon Jobs</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private List<DeviceDTO> _devices = new();
    private List<PeonDTO> _peons = new();
    private bool _loading = true;

    private int TotalDevices => _devices.Count;
    private int TotalPeons => _peons.Count;
    private int TotalPeonJobs => _devices.Sum(d => d.PeonConfigs.Count);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadDevicesAsync(), LoadPeonsAsync());
        _loading = false;
    }

    private async Task LoadDevicesAsync()
    {
        try { _devices = await Client.GetDevicesAsync(); }
        catch { }
    }

    private async Task LoadPeonsAsync()
    {
        try { _peons = await Client.GetPeonsAsync(); }
        catch { }
    }
}
