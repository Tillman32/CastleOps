@using System.Net.Http.Json
@using CastleOps.Core.DTOs;
@using CastleOps.Core.HTTP.Clients;
@page "/devices"
@inject NavigationManager Navigation
@inject CastleOpsClient Client

<PageTitle>CastleOps - Devices</PageTitle>
<h1>Devices</h1>
<p>Here you can view and manage your connected devices.</p>
<br />

@if (devices?.Count == 0)
{
    <MudAlert Severity="Severity.Info">No devices found. Please add a device.</MudAlert>
}
else
    {
    <MudTable Items="@devices" Striped="true" Hover="true" OnRowClick="@((TableRowClickEventArgs<DeviceDTO> args) => RowClickEvent(args))" Style="cursor: pointer;">
        <HeaderContent>
            <MudTh>Device Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>IP Address</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Device Name">@context.Name</MudTd>
            @if (context.Status == "Active")
            {
                <MudTd DataLabel="Status"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /></MudTd>
                <MudTd DataLabel="IP Address"><a href="http://@context.IPAddress" target="_blank">@context.IPAddress</a></MudTd>
            }
            else
            {
                <MudTd DataLabel="Status"><MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" /></MudTd>
                <MudTd DataLabel="IP Address">N/A</MudTd>
            }
        </RowTemplate>
    </MudTable>
}

@code {
    private List<DeviceDTO> devices { get; set; } = new List<DeviceDTO>();

    private void RowClickEvent(TableRowClickEventArgs<DeviceDTO> tableRowClickEventArgs)
    {
        Navigation.NavigateTo($"/devices/details/{tableRowClickEventArgs.Item.Id}");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDevicesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading devices: {ex.Message}");
        }
    }

    private async Task LoadDevicesAsync()
    {
        var results = await Client.GetDevicesAsync();
        if (results.Any())
        {
            devices = results;
        }
    }
}